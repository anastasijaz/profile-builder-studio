# Copy this file to .env.local and fill in the values.
# All VITE_* variables are baked into the client bundle at build time,
# so never put secrets (like the Supabase service_role key) here.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → "anon" / publishable key (safe to expose; RLS protects data)
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# DEV ONLY (optional): skip sign-up while running `bun run dev` by signing in
# to a test account automatically. Ignored in production builds. Never put a
# real person's password here. Sign out to turn it off for the current tab.
VITE_DEV_LOGIN_EMAIL=
VITE_DEV_LOGIN_PASSWORD=

# Public URL of the app, used as the base for magic-link redirects.
# Leave empty locally to use the current browser origin.
# In production set it to e.g. https://melt.example.com
VITE_SITE_URL=
